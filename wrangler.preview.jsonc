{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aizombie01",
  "account_id": "7fd7ed1128ca3d125feaa279f4d4c547",
  "main": "./src/server.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "routes": [{ "pattern": "aizombietrend.video", "custom_domain": true }],
  "vars": {
    "VITE_BASE_URL": "https://aizombietrend.video",
    "VITE_RELEASE_MODE": "preview"
  },
  "observability": { "logs": { "enabled": true } }
}
